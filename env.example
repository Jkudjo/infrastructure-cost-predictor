# =============================================================================
# Infrastructure Cost Predictor - Environment Configuration
# =============================================================================

# Application Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-west-2

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/costdb
REDIS_URL=redis://localhost:6379/0

# Notification Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=admin@yourcompany.com

# Teams Configuration
TEAMS_WEBHOOK_URL=https://yourcompany.webhook.office.com/webhookb2/YOUR/TEAMS/WEBHOOK

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key

# ML Model Configuration
MODEL_RETRAIN_FREQUENCY=weekly
PREDICTION_HORIZON_DAYS=30
CONFIDENCE_THRESHOLD=0.8

# Budget Configuration
DEFAULT_BUDGET_LIMIT=10000
DEFAULT_ALERT_THRESHOLDS=80,90,100

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
